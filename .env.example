DATABASE_URL=sqlite:///./atlas.db
ATLAS_SESSION_SECRET=change-me-too
ATLAS_COOKIE_SECURE=false
ATLAS_ALLOWED_ORIGINS=http://localhost:5173
# Fuer Regulatory Intelligence (Pipeline-Schritt 4, Abschnitt 11.2): Key von
# console.anthropic.com, unabhaengig vom claude.ai-Chat-Zugang.
ANTHROPIC_API_KEY=

# --- Auth / SSO (Abschnitt 13.4) ---
# Passwort des Demo-Nutzers demo@atlas-demo.de, wird beim Seed gesetzt.
ATLAS_DEMO_PASSWORD=change-me
# Microsoft Entra ID. Beide Redirect-URIs (lokal und Produktion) muessen in der
# Azure-App-Registrierung zeichengenau hinterlegt sein.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback
# Ziel nach erfolgreichem Login. Lokal noetig, weil der Callback auf dem Backend-Port
# landet, das Frontend im Entwicklungsbetrieb aber auf 5173 laeuft.
ATLAS_POST_LOGIN_URL=http://localhost:5173
